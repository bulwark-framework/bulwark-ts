{
  "name": "@bulwark-framework/core",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rubric": {
      "types": "./dist/rubric/index.d.ts",
      "default": "./dist/rubric/index.js"
    },
    "./resolver": {
      "types": "./dist/resolver/index.d.ts",
      "default": "./dist/resolver/index.js"
    },
    "./workflows": {
      "types": "./dist/workflows/index.d.ts",
      "default": "./dist/workflows/index.js"
    },
    "./activities": {
      "types": "./dist/activities/index.d.ts",
      "default": "./dist/activities/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "default": "./dist/store/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./authoring": {
      "types": "./dist/authoring/index.d.ts",
      "default": "./dist/authoring/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "@typesafe-ai/sdk": "0.6.0",
    "commander": "15.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@temporalio/testing": "1.24.0",
    "vitest": "5.0.1",
    "@temporalio/worker": "1.24.0",
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  },
  "bin": {
    "bulwark": "./dist/cli/index.js"
  }
}
